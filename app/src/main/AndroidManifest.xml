<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keeps playing with the screen off (media notification) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Installs its own updates (Android asks the user first) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Two processes, on purpose:
        - main process: the media session, notification and Android Auto (no WebView, no screens)
        - ":web" process: the WebView and the app screens
        A WebView crash or freeze therefore can never take Android Auto down with it.
    -->

    <!-- To show the Android Auto app version on the Info page. -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
    </queries>

    <application
        android:hardwareAccelerated="true"
        android:name=".AAYoutubeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="AAYoutube"
        android:theme="@style/Theme.AAYoutube"
        android:usesCleartextTraffic="false"
        android:appCategory="game">
        <provider android:name="com.aayoutube.app.CrashJournalProvider" android:authorities="${applicationId}.crashjournal" android:exported="false" android:initOrder="100" />
        <provider android:name="com.aayoutube.app.CrashJournalProvider" android:authorities="${applicationId}.crashjournal.web" android:process=":web" android:exported="false" android:initOrder="100" />


        <meta-data
            android:name="distractionOptimized"
            android:value="true" />
        <meta-data
            android:name="android.max_aspect"
            android:value="4.0" />

        <!-- Tells Android Auto this is a media app -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:process=":web"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.max_aspect"
                android:value="5.0" />
            <!-- Fill the car display (it can be very wide and short). -->
            <layout
                android:minWidth="1dp"
                android:minHeight="1dp"
                android:gravity="fill"
                android:defaultWidth="800dp"
                android:defaultHeight="480dp" />
            <!-- Legacy Assistant / Android Auto voice request. Media3 also handles modern
                 onSearch / onAddMediaItems calls in PlaybackService. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Opens YouTube links in this app -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="youtu.be" />
            </intent-filter>
        </activity>

        <!-- Keeps the web process alive and relays commands to the WebView (bound only by PlaybackService) -->
        <!-- Exact AABrowser legacy CarActivityService entry, backed by the pinned aauto.aar.
             CarActivity is instantiated by the projection SDK; it is NOT a manifest Activity. -->
        <service
            android:name=".LegacyProjectionService"
            android:process=":web"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION_OEM" />
            </intent-filter>
        </service>

        <service
            android:name=".WebHostService"
            android:process=":web"
            android:exported="false" />

        <!-- Media3 media library: exposed to Android Auto as an audio player, independently of
             the video screen (CarVideoService / car launcher). The same session also serves
             Bluetooth, notifications, and voice search. -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Enables media-button delivery and Media3 playback resumption after service recreation -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Shares a downloaded update APK with Android's installer (read-only, not exported) -->
        <provider
            android:name=".UpdateFileProvider"
            android:process=":web"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
